kill-to-/(){
local saved_mark=${MARK}
zle set-mark-command
zle forward-to-/
zle kill-region
MARK=${saved_mark}
}



zle -N kill-backward-to-/
kill-backward-to-/(){
    local saved_mark=${MARK}
    zle set-mark-command
    zle backward-to-/
    zle kill-region
    MARK=${saved_mark}
}


