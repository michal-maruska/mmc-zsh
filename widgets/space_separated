# is forward-word the same as backward-word-match ?


backward-to-/ () {
    if ((CURSOR == 0)); then
	return
    elif (( --CURSOR == 0 ));  then
	return
    fi

    # at the end I'm on the / -- that means cursor is after
    while [[ $BUFFER[$CURSOR] != '/' ]]
	  do
	      if (( --CURSOR == 0 ));  then
		  break
	      fi
    done
}


forward-to-/ () {
    if ((CURSOR == $#BUFFER)); then
	return
    elif (( ++CURSOR == $#BUFFER ));  then
	return
    fi

    # at the end I'm on the / -- that means cursor is after
    while [[ $BUFFER[$CURSOR] != '/' ]]
	  do
	      if (( ++CURSOR == $#BUFFER ));  then
		  break
	      fi
    done
}


zle -N backward-to-/
zle -N forward-to-/


bindkey "\e/" forward-to-/
