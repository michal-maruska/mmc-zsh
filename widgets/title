if false;
    then
# preexec hook shows command in title as it's running,
# and precmd sets it to something else when it's done.
    case $TERM in
	xterm*|screen*)
	    preexec () {
		export CURRENTCMD="$1"
		print -Pn "\e]0;$1\a"
	    }
	    precmd () {
		if [[ ! -z $CURRENTCMD ]]; then
		    print -Pn "\e]0;($CURRENTCMD)\a"
		fi
	    }
	    ;;
    esac
fi




mytitle() {
       # Use these two for GNU Screen:
#       dir=${pwd}
#    print -nR $'\033k'$1$'\033'\\
#	print -nR $'\033]0;'$2$'\a'

       # Use this one instead for XTerms:
    print -nR $'\033]0;'$LOGNAME"@"$HOST":"${TTY##*/}" "$PWD" "$*$'\a'
    #  $TTY!
}

