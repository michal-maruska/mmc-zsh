function caphuso_help (){
    # miciah:
    # buf="$BUFFER$RBUFFER";

    # what is this:  ##PATTERN -> same as "Filename Generation"
    #    # 0 or more occurence/repetition.             & this
    #
    run-help ${${BUFFER##[[:blank:]]#((noglob|sudo)#[[:blank:]]#)#}%% *}
    # Push the arguments onto the editing buffer stack, separated by spaces.
    # (q) ??
    print -z ${(q)BUFFER}
    # send-break (^G ESC-^G) (unbound) (unbound)
    # Abort the current editor function, e.g.  execute-named-command, or
    # the editor itself, e.g.  if you are in vared.  Otherwise abort the
    zle send-break
    # miciah does here:
    # zle .redisplay
};
zle -N caphuso_help;

bindkey '^xt' caphuso_help

