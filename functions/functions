# From maruska-preference:

function hist()
{
    grep -a -r $1 ~/.zsh_history
}

function cd ()
{
    if  [[ $# -gt 0 ]] && [[ ! "$1" = "-" ]] && [[  -f "$1" ]]; then
        builtin cd $1:h
    else
#     echo "not a file"
        builtin cd $*
    fi
}

