shell_interactive(){
if under_bash; then
   true;
   # set -o history
   # or interactive_comments

else
    if under_zsh
    then
        if [[ -o interactive ]]; then
            true;
        else
            false
        fi
    else
    # other shells are not interactive!
      false
    fi
fi
}

