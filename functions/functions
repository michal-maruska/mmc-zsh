# these functions _must_ be portable !!!


under_bash(){
 [ ! -z $BASH_VERSION ]
 # [ "$SHELL" = "/bin/bash" -o  "$SHELL" = "/bin/sh" -o "$SHELL" = "/bin/rbash" ]
}

under_zsh(){
  [ ! -z $ZSH_VERSION ]
 #[ "$SHELL" = "/bin/zsh" ]
}


under_xterm(){
#echo "under xterm $TERM"
[ "$TERM" = "xterm" -o  "$TERM" = "rxvt"  -o  "$TERM" = "rxvt-unicode" ]
# [[ $TERM == xterm ]]
}

