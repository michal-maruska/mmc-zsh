CMD=podman

if [ $# -eq 0 ]; then
    man $CMD
else
    local al
    # $(git config --get "alias.$1")

    # fixme: more can be used!
    if al=$1; then
        subcmd=${al%% *}
    fi

    if [[ $subcmd =~ '^-.*' ]]
    then
        man $CMD
    else

        if op=$2; then
            oper=${op%% *}
        fi

        if [[ $oper =~ '^-.*' || -z $oper ]]
        then
            man $CMD-$subcmd
        else
            case $subcmd in
                container)
                    man $CMD-$subcmd-$oper
                    ;;
                *)
                    man $CMD-$subcmd
            esac
        fi
    fi
fi
